---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Words from "../components/Words.astro";
import Btn from "../components/Btn.astro";
import Faq from "../components/Faq.astro";
import { site, getStarted } from "../data/site";
---

<Layout title={`Get Started | ${site.name}`}>
  <PageHero title={getStarted.title} dim={getStarted.dim}>
    <p>{getStarted.text}</p>
    <Btn href={site.cta.href} variant="w">{site.cta.label}</Btn>
  </PageHero>

  <section class="light" data-nav="light">
    <div class="wrap">
      <div class="split" style="border-top:0;padding-top:0">
        <Words text={getStarted.whatTitle} />
        <ul class="plist rv">{getStarted.what.map((p) => <li>{p}</li>)}</ul>
      </div>
      <div class="split">
        <Words text={getStarted.howTitle} />
        <ol class="plist rv">{getStarted.how.map((p) => <li>{p}</li>)}</ol>
      </div>
      <div class="split">
        <Words text={getStarted.faqTitle} />
        <Faq style="margin-top:0" />
      </div>
    </div>
  </section>
</Layout>
