---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Words from "../components/Words.astro";
import Btn from "../components/Btn.astro";
import { site, about, home } from "../data/site";

const badge = home.proof.badge;
---

<Layout title={`About FlowOpz: GoHighLevel & Automation Specialists`} description="FlowOpz is a developer-led GoHighLevel and workflow automation team. Lean GHL architecture, true speed-to-lead and fully documented handoffs." final={about.final}>
  <PageHero eyebrow={about.eyebrow} title={about.title} dim={about.dim}>
    <p>{about.text}</p>
    <Btn href={site.cta.href} variant="w">{site.cta.label}</Btn>
  </PageHero>

  <section class="light" data-nav="light">
    <div class="wrap">
      <p class="mono kick">{about.philosophyKicker}</p>
      <Words text={about.philosophyTitle} />
      <div class="prose rv" style="margin-top:34px">{about.prose.map((p) => <p>{p}</p>)}</div>
      <div class="split" style="margin-top:70px">
        <Words text={about.valuesTitle} />
        <ol class="plist rv">{about.values.map((v) => <li><span><b>{v.title}.</b> {v.text}</span></li>)}</ol>
      </div>
      <div class="split">
        <Words text={about.toolkitTitle} />
        <ul class="tools rv">
          {about.toolkit.map((t) => <li><span class="mono">{t.category}</span><b>{t.tools}</b></li>)}
        </ul>
      </div>
      <div class="split">
        <Words text={about.credsTitle} />
        <div class="rv">
          <div class="row">
            {about.creds.map((c) => <Btn href={c.href} variant={c.style as "d" | "o"}>{c.label}</Btn>)}
          </div>
          {
            badge.src && (
              <a class="badge" style="margin-top:34px" href={badge.href} target="_blank" rel="noopener noreferrer">
                <img src={badge.src} alt={badge.alt} width="104" height="104" loading="lazy" decoding="async" />
              </a>
            )
          }
        </div>
      </div>
    </div>
  </section>
</Layout>
