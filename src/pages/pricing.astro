---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Words from "../components/Words.astro";
import Btn from "../components/Btn.astro";
import Faq from "../components/Faq.astro";
import { site, pricing } from "../data/site";
---

<Layout title={`Pricing & Offers | ${site.name}`}>
  <PageHero eyebrow={pricing.eyebrow} title={pricing.title} dim={pricing.dim}>
    <p>{pricing.text}</p>
    <Btn href={site.cta.href} variant="w">{site.cta.label}</Btn>
  </PageHero>

  <section class="light" data-nav="light">
    <div class="wrap">
      <div class="offer plans">
        {
          pricing.plans.map((p, i) => (
            <div class={`big-card rv ${p.style}`} style={`--d:${i * 0.1}s`}>
              <div>
                <p class="mono">{p.name}</p>
                <p class="pr">{p.price}<small>{p.period}</small></p>
                <p class="obj">{p.text}</p>
              </div>
              <div>
                <ul>{p.points.map((pt) => <li>{pt}</li>)}</ul>
                <Btn href={site.cta.href} variant="w">{site.cta.label}</Btn>
              </div>
            </div>
          ))
        }
      </div>
      <div class="split" style="margin-top:70px">
        <Words text={pricing.estimatesTitle} />
        <ul class="plist rv">{pricing.estimates.map((e) => <li><span><b>{e.hours}:</b> {e.text}</span></li>)}</ul>
      </div>
      <div class="split">
        <Words text={pricing.faqTitle} />
        <Faq style="margin-top:0" />
      </div>
    </div>
  </section>
</Layout>
