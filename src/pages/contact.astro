---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Btn from "../components/Btn.astro";
import Arrow from "../components/Arrow.astro";
import CalEmbed from "../components/CalEmbed.astro";
import { site, contact } from "../data/site";
---

<Layout title={`Hire a GoHighLevel Expert | Contact ${site.name}`} description="Talk to a GoHighLevel and automation expert about your GHL setup, snapshot, integration or automation audit. We respond within 1 hour.">
  <PageHero eyebrow={contact.eyebrow} title={contact.title} dim={contact.dim}>
    <div class="contact-low">
      <p>{contact.text}</p>
      <ul class="cdetails">{contact.details.map((d) => <li><span class="mono">{d.label}</span><b>{d.value}</b></li>)}</ul>
    </div>
    <div class="row">
      {site.whatsapp && <Btn href={`https://wa.me/${site.whatsapp}`} variant="w">{site.whatsappLabel}</Btn>}
      <Btn href={`mailto:${site.email}`} variant={site.whatsapp ? "g" : "w"}>{site.email}</Btn>
    </div>
  </PageHero>

  <section class="light" data-nav="light" style="padding-top:clamp(40px,6vw,80px)">
    <div class="wrap">
      <div class="cgrid">
        <CalEmbed />
        <form id="lead" data-webhook={site.formWebhook} data-email={site.email} novalidate>
          <h2>{contact.formTitle}</h2>
          <label>Full Name<input name="name" autocomplete="name" required /></label>
          <label>Business Email<input name="email" type="email" autocomplete="email" required /></label>
          <label>Company / Agency Name<input name="company_name" autocomplete="organization" /></label>
          <label>Service Required
            <select name="service">
              <option value="">Select a service</option>
              {contact.serviceOptions.map((o) => <option>{o}</option>)}
            </select>
          </label>
          <label>Estimated Timeline<input name="timeline" placeholder={contact.timelinePlaceholder} /></label>
          <label>Project Details<textarea name="details"></textarea></label>
          <input class="hp" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button class="btn v" type="submit">Send request<Arrow /></button>
          <p class="status" id="status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>
</Layout>
