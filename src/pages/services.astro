---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Words from "../components/Words.astro";
import Btn from "../components/Btn.astro";
import { site, services } from "../data/site";
---

<Layout title={`Services | ${site.name}`}>
  <PageHero eyebrow={services.eyebrow} title={services.title} dim={services.dim}>
    <p>{services.text}</p>
    <div class="row">
      <Btn href={site.cta.href} variant="w">{site.cta.label}</Btn>
      <Btn href={site.offersCta.href} variant="g">{site.offersCta.label}</Btn>
    </div>
  </PageHero>

  <section class="light" data-nav="light">
    <div class="wrap">
      <div class="offer plans">
        {
          services.offers.map((o, i) => (
            <div class={`big-card svc rv ${o.style}`} id={o.id} style={`--d:${i * 0.1}s`}>
              <div>
                <p class="mono">{o.kicker}</p>
                <h2>{o.title}</h2>
                <p class="obj">{o.objective}</p>
              </div>
              <div>
                <p class="mono">Deliverables</p>
                <ul>{o.points.map((pt) => <li>{pt}</li>)}</ul>
                <Btn href={site.cta.href} variant="w">{site.cta.label}</Btn>
              </div>
            </div>
          ))
        }
      </div>
      <div class="split" style="margin-top:70px">
        <Words text={services.processTitle} />
        <ol class="plist rv">{services.process.map((p) => <li>{p}</li>)}</ol>
      </div>
    </div>
  </section>
</Layout>
