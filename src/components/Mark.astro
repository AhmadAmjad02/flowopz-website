---
// Flowopz ring mark. Ring + centre dot follow `currentColor`; the node stays lime.
// `outline` adds a dark edge to the lime node for light backgrounds.
interface Props {
  class?: string;
  outline?: boolean;
}
const { class: className, outline = false } = Astro.props;
---

<svg viewBox="6 6 52 52" aria-hidden="true" class:list={["mark-svg", className]}>
  <circle class="ring" cx="32" cy="32" r="18" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-dasharray="88 25" transform="rotate(-90 32 32)"></circle>
  <circle class="node" cx="15.4" cy="25" r="7" fill="#C6F432" stroke={outline ? "#0B0B0C" : "none"} stroke-width="1.6"></circle>
  <circle class="dot" cx="32" cy="32" r="4" fill="currentColor"></circle>
</svg>
