---
import Words from "./Words.astro";
import Btn from "./Btn.astro";
import { home } from "../data/site";

type Link = { label: string; href: string };
export type FinalContent = { title: string; dim: string; note: string; primary: Link; secondary: Link };

interface Props {
  content?: FinalContent;
}
const final = Astro.props.content ?? home.final;
---

<section class="final" data-nav="dark">
  <div class="fin">
    <div>
      <Words text={final.title} dim={final.dim} />
      <p class="n">{final.note}</p>
      <div class="row">
        <Btn href={final.primary.href} variant="w">{final.primary.label}</Btn>
        <Btn href={final.secondary.href} variant="g">{final.secondary.label}</Btn>
      </div>
    </div>
    <div class="chrome-wrap">
      <canvas id="chrome" aria-hidden="true"></canvas>
      <svg id="chrome-fb" hidden viewBox="0 0 100 100" aria-hidden="true">
        <defs>
          <linearGradient id="ch" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#fff"></stop>
            <stop offset=".45" stop-color="#A1A1AA"></stop>
            <stop offset=".6" stop-color="#1C1C20"></stop>
            <stop offset="1" stop-color="#F2F2F4"></stop>
          </linearGradient>
        </defs>
        <path fill="url(#ch)" d="M50 0C54 30 70 46 100 50 70 54 54 70 50 100 46 70 30 54 0 50 30 46 46 30 50 0Z"></path>
      </svg>
    </div>
  </div>
</section>
